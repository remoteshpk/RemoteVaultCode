<Page
    x:Class="RemoteVault.Desktop.WPF.Views.RestorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:RemoteVault.Desktop.WPF.ViewModels"
    mc:Ignorable="d"
    Style="{StaticResource AppRoot}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="MainGrid" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <TextBlock FontSize="34" FontWeight="SemiBold"
                           Text="{Binding PageTitle}" Margin="0,0,0,8" />
                <TextBlock MaxWidth="900" HorizontalAlignment="Left" Opacity="0.78"
                           Text="{Binding PageSubtitle}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Source + Destination -->
            <Border Grid.Row="2" Padding="20" CornerRadius="14"
                    Background="{StaticResource CardBackgroundBrush}">
                <StackPanel>
                    <TextBlock FontSize="22" FontWeight="SemiBold"
                               Text="What to restore, and where"
                               Margin="0,0,0,18" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Backup source -->
                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                                   Text="Backed-up folder" />
                        <ComboBox Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3"
                                  ItemsSource="{Binding SourceOptions}"
                                  SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  HorizontalAlignment="Stretch" />

                        <!-- Remote path -->
                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
                                   Text="Location in bucket" />
                        <TextBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3"
                                 IsReadOnly="True"
                                 Text="{Binding RemotePath}" />

                        <!-- Destination -->
                        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"
                                   Text="Restore to" />
                        <TextBox Grid.Row="4" Grid.Column="2"
                                 Text="{Binding DestinationFolder, Mode=TwoWay}" />
                        <Button Grid.Row="4" Grid.Column="4"
                                Content="Browse..."
                                Click="OnBrowseDestinationClick" />

                        <!-- Radio buttons -->
                        <StackPanel Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="3"
                                    Orientation="Horizontal">
                            <RadioButton Content="Original folder"
                                         Tag="original" Margin="0,0,16,0"
                                         IsChecked="{Binding RestoreToOriginal}"
                                         Checked="OnDestinationModeChecked" />
                            <RadioButton Content="A different folder"
                                         Tag="custom"
                                         IsChecked="{Binding RestoreToCustom}"
                                         Checked="OnDestinationModeChecked" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- File browser -->
            <Border Grid.Row="4" Padding="20" CornerRadius="14"
                    Background="{StaticResource CardBackgroundBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Backed-up files" Margin="0,0,0,4" />
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button Command="{Binding UpCommand}" Margin="0,0,10,0" ToolTip="Go up one folder" AutomationProperties.Name="Up">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFontFamily}" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Up" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RefreshCommand}" ToolTip="Reload this folder" AutomationProperties.Name="Refresh">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFontFamily}" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Refresh" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border BorderBrush="{StaticResource CardStrokeBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header row -->
                            <Border Grid.Row="0" CornerRadius="13,13,0,0"
                                    Background="{StaticResource CardBackgroundSecondaryBrush}"
                                    BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="0,0,0,1">
                            <Grid Margin="16,10,16,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Style="{StaticResource ColumnHeaderText}" Text="Name" />
                                <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeaderText}"
                                           HorizontalAlignment="Left" Text="Type" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeaderText}"
                                           HorizontalAlignment="Left" Text="Size (KB)" />
                                <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeaderText}" Text="Modified" />
                            </Grid>
                            </Border>

                            <!-- Browser list -->
                            <ListBox x:Name="BrowserListBox" Grid.Row="1"
                                     ItemsSource="{Binding BrowserItems}"
                                     SelectedItem="{Binding SelectedBrowserItem, Mode=TwoWay}"
                                     SelectionMode="Extended"
                                     HorizontalContentAlignment="Stretch"
                                     MinHeight="200"
                                     MouseDoubleClick="OnBrowserItemDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:RestoreBrowserItem}">
                                        <Grid Margin="16,10,16,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="160" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource RowIcon}">
                                                            <Setter Property="Text" Value="&#xE7C3;" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="Dir">
                                                                    <Setter Property="Text" Value="&#xE8B7;" />
                                                                    <Setter Property="Foreground" Value="{StaticResource BrandAccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="File" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="Dir">
                                                                <Setter Property="Text" Value="Folder" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Modified}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Action buttons -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" HorizontalAlignment="Left"
                        Content="Restore folder as of a date..."
                        Click="OnRestoreFolderByTimestampClick" />
                <Button Grid.Column="1"
                        Content="Earlier versions..."
                        Click="OnShowVersionsClick" />
                <Button Grid.Column="3" Style="{StaticResource PrimaryButton}"
                        Content="Restore selected"
                        Click="OnRestoreSelectedClick" />
            </Grid>

            <!-- Footer -->
            <TextBlock Grid.Row="8" Opacity="0.72"
                       Text="{Binding FooterMessage}"
                       TextWrapping="Wrap" />
        </Grid>
    </ScrollViewer>
</Page>
