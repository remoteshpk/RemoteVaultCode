<Page
    x:Class="RemoteVault.Desktop.WPF.Views.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:RemoteVault.Desktop.WPF.ViewModels"
    mc:Ignorable="d"
    Style="{StaticResource AppRoot}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="MainGrid" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Left">
                <TextBlock FontSize="34" FontWeight="SemiBold"
                           Text="{Binding PageTitle}" Margin="0,0,0,8" />
                <TextBlock MaxWidth="900" Opacity="0.78"
                           Text="{Binding PageSubtitle}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Source summary + table -->
            <Border Grid.Row="2" Padding="24" CornerRadius="18"
                    Background="{StaticResource CardBackgroundBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="20" FontWeight="SemiBold"
                                       Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="{Binding ConfigSummary}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button Command="{Binding BackupSelectedSourcesCommand}"
                                    Content="Back up selected folders"
                                    IsEnabled="{Binding CanTriggerSelectedBackup}"
                                    Margin="0,0,10,0" />
                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding RunFullBackupNowCommand}"
                                    Content="Back up everything now"
                                    IsEnabled="{Binding CanTriggerFullBackup}" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar IsIndeterminate="True" Margin="0,0,0,12"
                                 Visibility="{Binding IsBackupRunning, Converter={StaticResource BoolToVis}}" />

                    <Border BorderBrush="{StaticResource CardStrokeBrush}"
                            BorderThickness="1" CornerRadius="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Column header -->
                            <Border Grid.Row="0" CornerRadius="13,13,0,0"
                                    Background="{StaticResource CardBackgroundSecondaryBrush}"
                                    BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="0,0,0,1">
                            <Grid Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="2.4*" />
                                    <ColumnDefinition Width="2.4*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeaderText}" Text="Local folder" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeaderText}" Text="Location in bucket" />
                                <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeaderText}" Text="Last result" />
                                <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeaderText}" Text="Files changed" />
                            </Grid>
                            </Border>

                            <ListBox Grid.Row="1" MinHeight="96" MaxHeight="290"
                                     ItemsSource="{Binding BackupSources}"
                                     SelectedItem="{Binding SelectedBackupSource, Mode=TwoWay}"
                                     SelectionMode="Single"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:BackupSourceStatusItem}">
                                        <Grid Margin="0,10,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="2.4*" />
                                                <ColumnDefinition Width="2.4*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" HorizontalAlignment="Center"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding LocalFolder}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Text="{Binding RemotePath}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="3" Text="{Binding Result}" />
                                            <TextBlock Grid.Column="4" Text="{Binding FilesChanged}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Log -->
            <Border Grid.Row="4" Padding="24" CornerRadius="18"
                    Background="{StaticResource CardBackgroundBrush}">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold"
                               Text="Log" Margin="0,0,0,10" />
                    <TextBox AcceptsReturn="True" Height="260" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                             Text="{Binding ExecutionLog, Mode=OneWay}"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,10" />
                    <TextBlock Opacity="0.72" Text="{Binding FooterMessage}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
