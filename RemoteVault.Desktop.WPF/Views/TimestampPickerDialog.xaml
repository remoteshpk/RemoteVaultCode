<Window
    x:Class="RemoteVault.Desktop.WPF.Views.TimestampPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Restore folder as of a date" Width="400" Height="250"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Style="{StaticResource AppRoot}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Restore the folder as it was at this date and time:" />

        <DatePicker Grid.Row="2" x:Name="DatePickerControl"
                    HorizontalAlignment="Left" />

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <TextBlock Text="Hour" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="HourBox" Width="50" Text="0" />
            <TextBlock Text="Minute" VerticalAlignment="Center" Margin="12,0,8,0" />
            <TextBox x:Name="MinuteBox" Width="50" Text="0" />
            <TextBlock Text="Second" VerticalAlignment="Center" Margin="12,0,8,0" />
            <TextBox x:Name="SecondBox" Width="50" Text="0" />
        </StackPanel>

        <TextBlock Grid.Row="6" x:Name="ErrorText" Foreground="Red"
                   Visibility="Collapsed" TextWrapping="Wrap" />

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Continue" Click="OnContinueClick" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Margin="0,0,10,0" />
            <Button Content="Cancel" Click="OnCancelClick" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
