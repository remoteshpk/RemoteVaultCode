<Page
    x:Class="RemoteVault.Desktop.WPF.Views.DatabaseBackupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:RemoteVault.Desktop.WPF.ViewModels"
    mc:Ignorable="d"
    Style="{StaticResource AppRoot}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="MainGrid" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <TextBlock FontSize="34" FontWeight="SemiBold"
                           Text="{Binding PageTitle}" Margin="0,0,0,8" />
                <TextBlock MaxWidth="920" HorizontalAlignment="Left" Opacity="0.78"
                           Text="{Binding PageSubtitle}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Info card -->
            <Border Grid.Row="2" Padding="16" CornerRadius="10" BorderThickness="1"
                    BorderBrush="{StaticResource InfoStrokeBrush}" Background="{StaticResource InfoBackgroundBrush}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="How database backup works" Margin="0,0,0,6" />
                    <TextBlock Opacity="0.78"
                               Text="RemoteVault saves each database to a backup file on this computer, then uploads the file to your storage. To restore, download the file from the Restore page and load it with your database tools."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Profiles list -->
            <Border Grid.Row="4" Padding="24" CornerRadius="14"
                    Background="{StaticResource CardBackgroundBrush}">
                <StackPanel>
                    <TextBlock FontSize="22" FontWeight="SemiBold"
                               Text="{Binding StatusMessage}" Margin="0,0,0,16" />

                    <Border BorderBrush="{StaticResource CardStrokeBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header row -->
                            <Border Grid.Row="0" CornerRadius="13,13,0,0"
                                    Background="{StaticResource CardBackgroundSecondaryBrush}"
                                    BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="0,0,0,1">
                            <Grid Margin="16,10,16,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Style="{StaticResource ColumnHeaderText}" Text="Profile" />
                                <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeaderText}"
                                           HorizontalAlignment="Left" Text="Type" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeaderText}"
                                           HorizontalAlignment="Left" Text="Host" />
                                <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeaderText}"
                                           HorizontalAlignment="Left" Text="Databases" />
                                <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeaderText}"
                                           HorizontalAlignment="Left" Text="Differential" />
                                <TextBlock Grid.Column="5" Style="{StaticResource ColumnHeaderText}"
                                           HorizontalAlignment="Left" Text="Full sets kept" />
                            </Grid>
                            </Border>

                            <!-- Profiles ListBox -->
                            <ListBox x:Name="ProfilesListBox" Grid.Row="1"
                                     ItemsSource="{Binding Profiles}"
                                     SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                     SelectionMode="Extended"
                                     HorizontalContentAlignment="Stretch"
                                     MinHeight="200">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:DatabaseBackupProfileItem}">
                                        <Grid Margin="16,10,16,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding ProfileName}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding DatabaseTypeDisplay}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Host}" />
                                            <TextBlock Grid.Column="3" Text="{Binding DatabaseCountDisplay}" />
                                            <TextBlock Grid.Column="4" Text="{Binding DiffModeDisplay}" />
                                            <TextBlock Grid.Column="5" Text="{Binding KeepFullChainsDisplay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Action buttons -->
            <Border Grid.Row="6" Padding="20" CornerRadius="14"
                    Background="{StaticResource CardBackgroundBrush}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Edit databases" Margin="0,0,12,0"
                            Command="{Binding UnlockEditingCommand}"
                            Visibility="{Binding UnlockButtonVisibility}" />
                    <Button Content="Add" Click="OnAddProfileClick"
                            IsEnabled="{Binding CanEditProfiles}"
                            Margin="0,0,12,0" />
                    <Button Content="Edit" Click="OnEditProfileClick"
                            IsEnabled="{Binding CanEditProfiles}"
                            Margin="0,0,12,0" />
                    <Button Content="Delete" Click="OnDeleteProfileClick"
                            IsEnabled="{Binding CanEditProfiles}"
                            Margin="0,0,12,0" />
                    <Button x:Name="RunFullNowButton" Content="Run full backup now" Style="{StaticResource PrimaryButton}"
                            Click="OnRunFullNowClick"
                            IsEnabled="{Binding CanRunBackups}"
                            Margin="0,0,12,0" />
                    <Button x:Name="RunDiffNowButton" Content="Run differential now"
                            Click="OnRunDiffNowClick"
                            IsEnabled="{Binding CanRunBackups}"
                            Margin="0,0,12,0" />
                    <Button Content="Save" Click="OnSaveProfilesClick"
                            IsEnabled="{Binding CanEditProfiles}"
                            Margin="0,0,12,0" />
                    <Button Content="Reload" Click="OnReloadClick"
                            IsEnabled="{Binding CanEditProfiles}" />
                </StackPanel>
            </Border>

            <!-- Footer -->
            <TextBlock Grid.Row="8" Opacity="0.72"
                       Text="{Binding FooterMessage}"
                       TextWrapping="Wrap" />
        </Grid>
    </ScrollViewer>
</Page>
