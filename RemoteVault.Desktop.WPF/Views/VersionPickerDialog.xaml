<Window
    x:Class="RemoteVault.Desktop.WPF.Views.VersionPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Earlier versions" Width="600" Height="420"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Style="{StaticResource AppRoot}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleBlock" FontSize="16" FontWeight="SemiBold" />

        <Border Grid.Row="2" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1">
            <ListBox x:Name="VersionListBox" SelectionMode="Single">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding VersionName}" />
                            <TextBlock Grid.Column="1" Text="{Binding DateTime}" />
                            <TextBlock Grid.Column="2" Text="{Binding SizeKb}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Restore this version" Click="OnRestoreClick" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Margin="0,0,10,0" />
            <Button Content="Close" Click="OnCloseClick" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
