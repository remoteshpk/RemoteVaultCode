<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>RemoteVault.Desktop.WPF</RootNamespace>
    <AssemblyName>RemoteVault</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <ApplicationIcon>Assets\Branding\RemoteVault.ico</ApplicationIcon>
    <Version>10.0.0</Version>
    <AssemblyVersion>10.0.0.0</AssemblyVersion>
    <FileVersion>10.0.0.0</FileVersion>
    <StartupObject>RemoteVault.Desktop.WPF.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteVault.Contracts\RemoteVault.Contracts.csproj" />
    <ProjectReference Include="..\RemoteVault.Infrastructure\RemoteVault.Infrastructure.csproj" />
    <ProjectReference Include="..\RemoteVault.Core\RemoteVault.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\Branding\RemoteVault.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Branding\RemoteVaultLogo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so XAML can show it; the None item above still copies it for the installer wizard. -->
    <Resource Include="Assets\Branding\RemoteVaultLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="app.manifest" />
  </ItemGroup>
</Project>
